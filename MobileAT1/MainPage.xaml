<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileAT1.MainPage">


        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="app_icon.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="app logo" />
        <Entry x:Name="SearchBox" Placeholder="Search for a game.."/>
        <Button
                    x:Name="SearchButton"
                    Text="Search" 
                    SemanticProperties.Hint="Counts the number of times you click"
                    Clicked="SearchButtonClicked"
                    HorizontalOptions="Fill" />
        </VerticalStackLayout>
</ContentPage>
