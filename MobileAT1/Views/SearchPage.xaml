<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileAT1.Views.SearchPage"
             Title="SearchPage"
             Loaded="OnPageLoaded">
    <ScrollView>
        <VerticalStackLayout>
            <ImageButton x:Name="CloseButton" Source="close_circle.png" Clicked="CloseButton_Clicked"/>
            <CollectionView x:Name="CollectionViewGames" SelectionChanged="CollectionViewGames_SelectionChanged" SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" x:Name="Game">
                            <VerticalStackLayout Margin="5" Padding="5">
                                <Image Source="{Binding Cover.ImageUrl}" WidthRequest="300" HeightRequest="200"/>
                                <Label Text="{Binding Title}" HorizontalOptions="Center" BackgroundColor="#00000080"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>