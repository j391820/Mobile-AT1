<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileAT1.Views.SettingsPage"
             Title="SettingsPage">
    <VerticalStackLayout Spacing="10">
        <Label HorizontalOptions="Center">Theme:</Label>
        <Picker x:Name="ThemePicker" SelectedIndexChanged="ThemePicker_SelectedIndexChanged" WidthRequest="250" HorizontalOptions="Center">
            <Picker.Items>
                <x:String>Light</x:String>
                <x:String>Dark</x:String>
            </Picker.Items>
        </Picker>
        <Label HorizontalOptions="Center">Font Size:</Label>
        <HorizontalStackLayout HorizontalOptions="Center">
            <Label Text="Selected Size: "/>
            <Label BindingContext="{x:Reference FontSlider}" Text="{Binding Value, StringFormat='{0:F0}'}" FontAttributes="Bold"/>
        </HorizontalStackLayout>
        <Slider x:Name="FontSlider" Minimum="10" Maximum="18" Value="10" WidthRequest="250" ValueChanged="FontSlider_ValueChanged"/>
    </VerticalStackLayout>
</ContentPage>